# Brevo (formerly Sendinblue) Transactional Email API (Recommended)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=RideShare

# Gmail SMTP Configuration for RideShare (Optional Secondary Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=RideShare
MAIL_ENABLED=true
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Google Drive driver-document storage (server-side only)
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\google-service-account.json

# Razorpay Payment Gateway (TEST MODE ONLY)
RAZORPAY_MODE=TEST
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
